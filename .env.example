# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Set these in Vercel, never commit real values.
SUPABASE_SECRET_KEY=        # Supabase > Project settings > API keys > secret key
ADMIN_PASSWORD=             # long password for the /admin back end
STRIPE_SECRET_KEY=          # Stripe > Developers > API keys (sk_test_... or sk_live_...)
SHIPPO_API_TOKEN=           # Shippo > Settings > API (shippo_test_... or shippo_live_...)
# STRIPE_WEBHOOK_SECRET=    # optional: /admin can register the webhook and store this for you

# Optional. Switches on reading of survey photos (inventory cards, parts bins).
# Without it, photos still upload and are kept; they are just not read.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
